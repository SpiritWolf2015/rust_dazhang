# 编辑器编码基线：UTF-8 无 BOM、LF 换行、末尾换行。
# 与 .gitattributes 共同保证所有平台写出的文件一致。
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.rs]
indent_style = space
indent_size = 4

[*.{toml,json,yaml,yml,md,py,js,mjs,ts,xml,cfg,example,sh,wgsl}]
indent_style = space
indent_size = 2

[*.md]
# Markdown 的行尾双空格用于强制换行，不做裁剪。
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.{png,jpg,jpeg,gif,ico,mpq,blp,mdx,mdl,w3x,w3m,glb,bin,exe,dll}]
# 二进制文件不参与文本编码检查。
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
