# rust_dazhang 配置模板——复制为 config.toml 后按需修改路径。
# config.toml 已被 .gitignore 忽略：它含有本机绝对路径，绝不能提交。
# 本仓库不含任何游戏资产；下面每个路径都指向你本机合法获得 / 导出的文件。
#
# 解析方：crates/w3-client/src/real_map.rs::load_paths
# 只识别下面 7 个 `key = "value"` 键（极简解析，无 toml 依赖；注释 / 分段
# 标题 / 未知键会被忽略）。键名与 `config.toml` 当前实际用法一致。

# 已解析的 Echo Isles 地图目录（w3-content::load_map 读取
# terrain-heightfield.json / units.json / doodads.json）。必填。
map_dir = "C:/open_rts/godot_warcraft3/assets/map-parsed/echoisles"

# 可选：地表 tileset SLK 表（阶段 2 贴图映射，当前装配未直接消费）。
tileset_table = "C:/open_rts/godot_warcraft3/assets/slk-exported/TerrainArt/Terrain.json"

# 可选：真实小地图底图 PNG（阶段 2 HUD 底图）。
minimap_image = "C:/open_rts/godot_warcraft3/assets/map-parsed/echoisles/war3mapMap.png"

# 可选：6 张 BLP→PNG 地表贴图目录（阶段 2 真实地表顶点色 / 阶段 4 GPU 平铺）。
# 目录内需含 Lords_Dirt.png / Lords_DirtRough.png / Lords_DirtGrass.png /
# Lords_Rock.png / Lords_Grass.png / Lords_GrassDark.png。
tileset_dir = "C:/open_rts/godot_warcraft3/assets/asset-converted/TerrainArt/LordaeronSummer"

# 可选：真实水面贴图 PNG（阶段 4 真 GPU 纹理管线的水贴图层）。
# 未配置时水顶点回退半透明纯色；已配置但文件读取 / 解码失败会显式报错
# （melee example 启动失败），故路径 MUST 指向本机存在且有效的 PNG。
water_texture = "C:/open_rts/godot_warcraft3/assets/asset-converted/ReplaceableTextures/Water/A_Water00.png"

# 可选：真实 glTF 模型根目录（阶段 3，asset-convert 产物，含 .gltf/.bin/PNG）。
models_dir = "C:/open_rts/godot_warcraft3/assets/asset-converted"

# 可选：SLK 表根目录（阶段 3 模型映射，需含 Units/unitUI.json 与
# Doodads/Doodads.json）。models_dir 与 slk_dir 必须同时提供才装配真实模型；
# 二者缺失时优雅降级到程序化几何、CI 无资产环境可跑。
slk_dir = "C:/open_rts/godot_warcraft3/assets/slk-exported"

# 说明：
# - 以上路径全部由只读参考项目 godot_warcraft3 的上游 dev-setup / asset-convert
#   在玩家本机从合法获得的经典客户端导出；本仓库零资产、绝不入库（ADR 0001）。
# - 缺 map_dir 或导出数据无效时 `cargo run -p w3-client --example melee`
#   显式失败、不回落合成 demo；玩法闭环 CPU 测试不依赖任何本机资产。
# - 确定性契约见 ADR 0002：权威模拟用定点数、整数帧 30 Hz、不读墙钟 / 刷新率。
